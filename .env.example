# Copy to .env and set your own values. .env is git-ignored.
POSTGRES_USER=pm_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=password_manager
POSTGRES_PORT=5432

# Used by the backend (Prisma) to connect to the database above
DATABASE_URL=postgresql://pm_app:change-me@localhost:5432/password_manager

# Signs access tokens (JWT). Long random value, e.g. 64 hex characters.
JWT_SECRET=change-me
# Server-side secret for fake prelogin salts. Long random value.
SERVER_SECRET=change-me
# Frontend address, used in invitation links
APP_URL=http://localhost:5173
